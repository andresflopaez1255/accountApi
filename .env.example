PORT=4000
CORS_ORIGINS=http://localhost:4200,https://your-frontend.example.com
JWT_SECRET=replace-with-a-long-random-secret
ALLOW_VENDOR_REGISTRATION=false
# Use one credential option: JSON in FIREBASE_CONFIG, a JSON string in
# FIREBASE_SERVICE_ACCOUNT_JSON, a local path, or GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_CONFIG={"type":"service_account","project_id":"your-project"}
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com
BOT_TOKEN=your-telegram-bot-token
BOT_WEBHOOK_URL=https://your-public-api.example.com
# Comma-separated Telegram chat IDs. Leave empty only during local setup.
BOT_ALLOWED_CHAT_IDS=
